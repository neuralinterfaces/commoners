    "electron": "^38.1.0",
    "electron-builder": "24.13.3",
    "electron-builder-squirrel-windows": "^24.0.0",
    "esbuild": "^0.23.0",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.0.0",
    "open": "^9.1.0",
    "pkg": "^5.8.1",
