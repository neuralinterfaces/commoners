{
  "name": "@commoners/solidarity",
  "description": "Config resolution, build orchestration, service supervision and build records for Commoners",
  "keywords": [
    "tauri",
    "electron",
    "capacitor",
    "pwa",
    "cross-platform",
    "sidecar",
    "services",
    "sbom",
    "csp",
    "security"
  ],
  "version": "1.0.0-alpha.4",
  "type": "module",
  "author": "Neural Interfaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neuralinterfaces/commoners.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/main.mjs",
      "require": "./dist/main.cjs"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services.mjs",
      "require": "./dist/services.cjs"
    },
    "./ui": {
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "bonjour-service": "^1.4.4",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "dotenv": "^16.6.1",
    "esbuild": "^0.27.7",
    "figures": "^6.1.0",
    "js-yaml": "^4.3.2",
    "open": "^9.1.0",
    "ora": "^9.4.1",
    "path-browserify": "^1.0.1",
    "plist": "^3.1.1",
    "process": "^0.11.10",
    "vite": "^7.3.7",
    "ws": "^8.22.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.2",
    "@types/node": "^20.19.43",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "typescript": "^5.9.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "optionalDependencies": {
    "rcedit": "^4.0.1"
  },
  "peerDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@electron/fuses": "^2.1.0",
    "@electron/notarize": "^3.1.1",
    "electron": "^41.10.6",
    "electron-builder": "^26.8.1",
    "electron-builder-squirrel-windows": "^26.0.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@capacitor/android": {
      "optional": true
    },
    "@capacitor/assets": {
      "optional": true
    },
    "@capacitor/cli": {
      "optional": true
    },
    "@capacitor/ios": {
      "optional": true
    },
    "@electron/fuses": {
      "optional": true
    },
    "@electron/notarize": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "electron-builder": {
      "optional": true
    },
    "electron-builder-squirrel-windows": {
      "optional": true
    },
    "vite-plugin-pwa": {
      "optional": true
    }
  }
}
